    });
  } catch (err) {
    console.error(err);
    res.status(500).json({ message: "Dashboard fetch failed" });
  }
});

app.post("/api/checkout", auth, async (req, res) => {

  const connection = await db.getConnection();

  try {

    const {
      items,
      shipping_address,
      coupon,
      payment_method = "cod",
      payment_id = null,
      razorpay_order_id = null,
      razorpay_signature = null
    } = req.body;

    if (!items || items.length === 0)
      return res.status(400).json({ message: "Cart is empty" });

    if (!shipping_address?.phone)
      return res.status(400).json({ message: "Phone required" });


    /* =========================
       VERIFY PHONE (STRICT)
    ========================= */

    const [[verified]] =
      await connection.query(
        `SELECT id, expires_at
         FROM phone_otps
         WHERE phone = ?
         AND is_verified = 1
         ORDER BY created_at DESC
         LIMIT 1`,
        [shipping_address.phone]
      );

    if (!verified)
      return res.status(400).json({
        message: "Phone not verified"
      });

    if (new Date(verified.expires_at) < new Date())
      return res.status(400).json({
        message: "Phone verification expired"
      });

    // Consume OTP (one-time use)
    await connection.query(
      `UPDATE phone_otps
       SET is_verified = 0
       WHERE id = ?`,
      [verified.id]
    );


    await connection.beginTransaction();

    const orderId = uuidv4();


    /* =========================
       CALCULATE TOTAL
    ========================= */

    let subtotal = 0;

    for (const item of items)
      subtotal +=
        Number(item.price) *
        Number(item.quantity);

    const shipping = 50;
    const tax = Number((subtotal * 0.08).toFixed(2));

    let discount = 0;


    /* =========================
       COUPON VALIDATION
    ========================= */

    if (coupon) {

      const [[couponData]] =
        await connection.query(
          `SELECT *
           FROM coupons
           WHERE code = ?
           AND is_active = 1
           AND (expires_at IS NULL OR expires_at > NOW())
           AND (min_order_amount IS NULL OR ? >= min_order_amount)`,
          [coupon.toUpperCase(), subtotal]
        );

      if (couponData) {

        if (couponData.discount_type === "percentage")
          discount =
            subtotal *
            couponData.discount_value / 100;

        else if (couponData.discount_type === "fixed")
          discount =
            couponData.discount_value;

      }

    }

    discount = Number(discount.toFixed(2));

    const finalAmount =
      Number(
        (subtotal + tax + shipping - discount)
          .toFixed(2)
      );


    /* =========================
       VERIFY ONLINE PAYMENT
    ========================= */

    if (payment_method === "online") {

      if (!razorpay_order_id ||
          !payment_id ||
          !razorpay_signature)
        throw new Error("Missing payment details");

      const generatedSignature =
        crypto
          .createHmac("sha256",
            process.env.RAZORPAY_KEY_SECRET)
          .update(
            razorpay_order_id + "|" + payment_id
          )
          .digest("hex");

      if (generatedSignature !== razorpay_signature)
        throw new Error("Invalid payment signature");

    }


    /* =========================
       INSERT ORDER
    ========================= */

    await connection.query(

      `INSERT INTO orders
      (
        id,
        user_id,
        subtotal,
        tax,
        shipping_charge,
        discount,
        final_amount,
        payment_method,
        payment_status,
        payment_id,
        razorpay_order_id,
        razorpay_signature,
        status,
        address
      )
      VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?)`,
      [
        orderId,
        req.user.id,
        subtotal,
        tax,
        shipping,
        discount,
        finalAmount,
        payment_method,
        payment_method === "online"
          ? "paid"
          : "pending",
        payment_id,
        razorpay_order_id,
        razorpay_signature,
        "pending",
        JSON.stringify(shipping_address)
      ]

    );


    /* =========================
       INSERT ITEMS + STOCK LOCK
    ========================= */

    for (const item of items) {

      const isCustom =
        item.productId ===
        "customize-phone-cover";

      let productName =
        item.name || "Custom Product";

      if (!isCustom) {

        const [[product]] =
          await connection.query(
            `SELECT name, stock
             FROM products
             WHERE id = ?
             FOR UPDATE`,
            [item.productId]
          );

        if (!product)
          throw new Error("Product not found");

        if (product.stock < item.quantity)
          throw new Error("Insufficient stock");

        productName = product.name;

        await connection.query(
          `UPDATE products
           SET stock = stock - ?
           WHERE id = ?`,
          [item.quantity, item.productId]
        );

      }

      await connection.query(
        `INSERT INTO order_items
        (
          id,
          order_id,
          product_id,
          product_name,
          quantity,
          price,
          customization
        )
        VALUES (?, ?, ?, ?, ?, ?, ?)`,
        [
          uuidv4(),
          orderId,
          item.productId,
          productName,
          item.quantity,
          item.price,
          JSON.stringify(
            item.customization || {}
          )
        ]
      );

    }


    await connection.commit();


    /* =========================
       CLEANUP OLD OTPS
    ========================= */

    await db.query(
      `DELETE FROM phone_otps
       WHERE phone = ?`,
      [shipping_address.phone]
    );


    res.json({
      success: true,
      order_id: orderId,
      subtotal,
      tax,
      shipping,
      discount,
      final_amount: finalAmount
    });

  }
  catch (err) {

    await connection.rollback();
    console.error(err);

    res.status(400).json({
      message: err.message
    });

  }
  finally {

    connection.release();

  }

});






