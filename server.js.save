app.get("/api/orders/:id/invoice", auth, async (req, res) => {
  const { id } = req.params;

  try {

    // ✅ GET ORDER
    const [[order]] = await db.query(
      "SELECT * FROM orders WHERE id=? AND user_id=?",
      [id, req.user.id]
    );

    if (!order)
      return res.status(404).send("Order not found");


    // ✅ GET ORDER ITEMS (LEFT JOIN FIXED)
    const [items] = await db.query(
      `SELECT 
        oi.quantity,
        oi.price,
        oi.customization,

        COALESCE(
          p.name,
          'Custom Product'
        ) AS product_name,

        COALESCE(
          p.image,
          JSON_UNQUOTE(JSON_EXTRACT(p.images,'$[0]')),
          '/placeholder.svg'
        ) AS product_image

       FROM order_items oi

       LEFT JOIN products p
       ON p.id = oi.product_id

       WHERE oi.order_id=?`,
      [id]
    );


    // ✅ SAFE ADDRESS PARSE
    let address = {};
    try {
      address = order.address ? JSON.parse(order.address) : {};
    } catch {
      address = {};
    }


    // ✅ SAFE CUSTOMIZATION PARSE
    const orderItems = items.map(item => {

      let customization = null;

      if (item.customization) {

        if (typeof item.customization === "object")
          customization = item.customization;

        else {
          try {
            customization = JSON.parse(item.customization);
          }
          catch {
            customization = null;
          }
        }
      }

      return {
        ...item,
        customization,
        price: Number(item.price),
        quantity: Number(item.quantity),
        product_name: item.product_name || "Custom Product"
      };
    });


    // ✅ CALCULATIONS
    const subtotal =
      orderItems.reduce(
        (sum, i) =>
          sum + i.price * i.quantity,
        0
      );

    const shipping =
      Number(order.shipping_charge || 50);

    const tax =
      Number(order.tax || (subtotal * 0.08));

    const discount =
      Number(order.discount || 0);

    const total =
      Number(order.final_amount ||
      subtotal + shipping + tax - discount);



    // ✅ COMPANY INFO
    const COMPANY = {
      name: "The Design Hive Pvt. Ltd.",
      gst: "07ABCDE1234F1Z5",
      address: "A-102, Sector 63, Noida, Uttar Pradesh 201301",
      email: "support@thedesignhive.in",
      phone: "+91 98765 43210",
      website: "www.thedesignhive.in"
    };


    // ✅ PAYMENT TEXT (ONLY ADDITION)
    const paymentText =
      order.payment_method === "online"
        ? order.payment_status === "paid"
          ? "Paid Online (Razorpay)"
          : "Online Payment (Pending)"
        : "Cash on Delivery";


    const paymentIdHtml =
      order.payment_method === "online" &&
      order.payment_id
        ? `<p><strong>Payment ID:</strong> ${order.payment_id}</p>`
        : "";


    // ✅ HTML (UI SAME)
    const html = `
<!DOCTYPE html>
<html>
<head>
<meta charset="utf-8">
<title>Invoice #${id.slice(-8).toUpperCase()}</title>

<link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">

<style>

