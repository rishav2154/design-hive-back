/* =========================================================
   USER ORDERS (FOR NAVBAR → MY ORDERS)
========================================================= */
app.get("/api/orders", auth, async (req, res) => {

  try {

    const [orders] = await db.query(
      "SELECT * FROM orders WHERE user_id=? ORDER BY created_at DESC",
      [req.user.id]
    );

    const formattedOrders = [];

    for (const order of orders) {

      const [items] = await db.query(`
        SELECT 
          oi.id,
          oi.order_id,
          oi.product_id,
          oi.quantity,
          oi.price,
          oi.customization,
          COALESCE(p.name, 'Custom Product') AS product_name,
          COALESCE(
            p.image,
            COALESCE(JSON_UNQUOTE(JSON_EXTRACT(p.images,'$[0]')), '/placeholder.svg')
          ) AS product_image
        FROM order_items oi
        LEFT JOIN products p ON p.id = oi.product_id
        WHERE oi.order_id = ?
      `, [order.id]);

      const processedItems = items.map(item => {

        let customization = null;

        if (item.customization) {

          if (typeof item.customization === 'object')
            customization = item.customization;

          else {
            try {
              customization = JSON.parse(item.customization);
            } catch {
              customization = null;
            }
          }

        }

        return {
          id: item.id,
          product_id: item.product_id,
          product_name: item.product_name,
          product_image: item.product_image,
          quantity: item.quantity,
          price: Number(item.price),
          customization,
        };

      });

      const subtotal = processedItems.reduce(
        (sum, i) => sum + i.price * i.quantity, 0
      );

      const shipping = Number(order.shipping_charge || 50);
      const tax = Number(order.tax || 0);
      const discount = Number(order.discount || 0);

      const total =
        subtotal +
        shipping +
        tax -
        discount;

      formattedOrders.push({

        id: order.id,

        order_number:
          `ORD-${order.created_at
            .toISOString()
            .slice(0, 10)
            .replace(/-/g, "")}-${order.id.slice(0, 8)}`,

        status: order.status,

        // ✅ FIXED: use real DB values
        payment_method: order.payment_method || "cod",

        payment_status: order.payment_status || "pending",

        subtotal,
        shipping,
        tax,
        discount,
        total,

        shipping_address:
          JSON.parse(order.address || "{}"),

        created_at: order.created_at,

        order_items: processedItems,

      });

    }

    res.json(formattedOrders);

  }

  catch (err) {

    console.error("ORDERS ERROR:", err);

    res.status(500).json({
      message: "Failed to fetch orders"
    });

  }

});




