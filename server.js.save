/* =========================================================
   APPLY COUPON (FRONTEND CouponInput)
========================================================= */

app.post("/api/coupons/apply", async (req, res) => {
  const { code, subtotal } = req.body;

  const [rows] = await db.query(
    "SELECT * FROM coupons WHERE code=? AND is_active=1",
    [code]
  );
  if (!rows.length) return res.status(400).json({ message: "Invalid coupon" });

  const coupon = rows[0];

  if (coupon.min_order_amount && subtotal < coupon.min_order_amount) {
    return res.status(400).json({ message: "Minimum order not met" });
  }

  res.json(coupon);
});

/* =========================================================
   ORDERS (ADMIN)
========================================================= */
app.get("/admin/orders", auth, async (req, res) => {
  try {

    const [orders] = await db.query(`
      SELECT 
        o.id,
        o.user_id,

        o.status,

        /* ✅ PAYMENT INFO (FIXED) */
        o.payment_method,
        o.payment_status,
        o.payment_id AS razorpay_payment_id,   -- ✅ FIX HERE
        o.razorpay_order_id,
        o.razorpay_signature,

        o.created_at,

        /* AMOUNT INFO */
        o.subtotal,
        o.tax,
        o.shipping_charge,
        o.discount,
        o.final_amount,

        o.address,

        /* CUSTOMER INFO */
        JSON_UNQUOTE(
          JSON_EXTRACT(o.address, '$.full_name')
        ) AS customer_name,

        JSON_UNQUOTE(
          JSON_EXTRACT(o.address, '$.phone')
        ) AS customer_phone,

        u.email AS customer_email,

        /* ORDER STATS */
        COUNT(oi.id) AS items_count,

        COALESCE(
          SUM(oi.quantity * oi.price),
          0
        ) AS items_total

      FROM orders o

      LEFT JOIN users u
        ON u.id = o.user_id

      LEFT JOIN order_items oi
        ON oi.order_id = o.id

      GROUP BY o.id

      ORDER BY o.created_at DESC
    `);

    res.json(orders);

  } catch (err) {

    console.error("Admin orders fetch error:", err);

    res.status(500).json({
      success: false,
      message: "Failed to fetch orders"
    });

  }
});


app.get("/admin/orders/:id/items", auth, async (req, res) => {
  const [items] = await db.query(`
    SELECT 
      oi.*,
      p.name as product_name,
      p.images,
      TRIM(oi.product_id) as clean_product_id
    FROM order_items oi
    LEFT JOIN products p ON TRIM(oi.product_id) = p.id
    WHERE oi.order_id = ?
  `, [req.params.id]);
  res.json(items);
});

app.put("/admin/orders/:id/status", auth, async (req, res) => {
  const { status } = req.body;
  const validStatuses = ['pending', 'processing', 'shipped', 'delivered', 'cancelled'];
  
  if (!validStatuses.includes(status)) {
    return res.status(400).json({ error: 'Invalid status' });
  }

  const [result] = await db.query(
    "UPDATE orders SET status = ?, updated_at = NOW() WHERE id = ?",
    [status, req.params.id]
  );

  if (result.affectedRows === 0) {
    return res.status(404).json({ error: 'Order not found' });
  }

  res.json({ success: true, message: "Status updated" });
});
app.get("/admin/orders/:id/breakdown", auth, async (req, res) => {

  try {

    const orderId = req.params.id;

    const [[order]] = await db.query(`
      SELECT 
        subtotal,
        tax,
        shipping_charge AS shipping,
        discount,
        final_amount AS total
      FROM orders
      WHERE id = ?
    `, [orderId]);

    if (!order) {
      return res.status(404).json({
        error: "Order not found"
      });
    }

    res.json({
      subtotal: Number(order.subtotal || 0),
      tax: Number(order.tax || 0),
      shipping: Number(order.shipping || 0),
      discount: Number(order.discount || 0),
      total: Number(order.total || 0)
    });

  }
  catch (err) {

    console.error(err);

    res.status(500).json({
      error: "Failed to fetch breakdown"
    });

  }

});


